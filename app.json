{
  "expo": {
    "name": "myStuff",
    "slug": "mystuff-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mystuff",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.mystuff",
      "infoPlist": {
        "NSCameraUsageDescription": "myStuff needs access to your camera to scan QR codes on your storage containers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#334155"
      },
      "package": "com.yourname.mystuff",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#334155"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "myStuff needs access to your camera to scan QR codes on your storage containers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
